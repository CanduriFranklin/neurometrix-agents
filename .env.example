# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RESULTS=core-4d.results
KAFKA_TOPIC_CLASSIFIED=agents.classified
KAFKA_TOPIC_RETRIEVED=agents.retrieved
KAFKA_TOPIC_ANALYZED=agents.analyzed
KAFKA_TOPIC_DRAFT=agents.reports.draft
KAFKA_TOPIC_FINAL=agents.reports.final
KAFKA_CONSUMER_GROUP=agents-cg
KAFKA_AUTO_OFFSET_RESET=latest

# ---- Postgres ----
DATABASE_URL=postgresql://neurometrix:Enginer012%25@localhost:5432/neurometrix_core_4d

# ---- LLM ----
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed-for-vllm
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ---- RAG ----
CHROMA_PATH=./chroma_db
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
KNOWLEDGE_DIR=./knowledge

# ---- Runtime ----
LOG_LEVEL=INFO
REPORTS_DIR=./reports
